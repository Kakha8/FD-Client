<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<AnchorPane prefHeight="500.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="kakha.kudava.fdclient.controller.CsePageController">
   <children>
      <AnchorPane layoutX="23.0" layoutY="14.0"
                  prefHeight="82.0" prefWidth="555.0"
                  style="-fx-background-color: #f4f6f8; -fx-background-radius: 8; -fx-border-color: #d7dce1; -fx-border-radius: 8;">
         <children>
            <Label layoutX="14.0" layoutY="10.0"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"
                   text="Lockbox" />
            <Label fx:id="lockboxStatusLabel" layoutX="14.0" layoutY="39.0"
                   prefHeight="32.0" prefWidth="390.0" wrapText="true"
                   text="Checking this device's Lockbox status..." />
            <ProgressIndicator fx:id="activationProgress"
                               layoutX="425.0" layoutY="25.0"
                               managed="false" prefHeight="32.0" prefWidth="32.0"
                               visible="false" />
            <Button fx:id="activateLockboxBtn"
                    layoutX="414.0" layoutY="27.0"
                    mnemonicParsing="false"
                    onAction="#onActivateLockbox"
                    text="Activate Lockbox" />
            <Button fx:id="refreshLockboxBtn"
                    layoutX="470.0" layoutY="27.0"
                    managed="false" mnemonicParsing="false"
                    onAction="#onRefreshLockbox"
                    text="Refresh" visible="false" />
         </children>
      </AnchorPane>

      <AnchorPane fx:id="lockboxContentPane"
                  disable="true" layoutY="108.0"
                  prefHeight="380.0" prefWidth="600.0">
         <children>
            <TableView fx:id="lockboxFileTable" layoutX="23.0" layoutY="0.0"
                       prefHeight="190.0" prefWidth="555.0">
               <columns>
                  <TableColumn fx:id="nameColumn" prefWidth="255.0" text="Name" />
                  <TableColumn fx:id="sizeColumn" prefWidth="110.0" text="Size" />
                  <TableColumn fx:id="locationColumn" prefWidth="135.0" text="Location" />
                  <TableColumn fx:id="actionsColumn" prefWidth="45.0" sortable="false" text="" />
               </columns>
            </TableView>

            <Label layoutX="35.0" layoutY="218.0"
                   prefHeight="17.0" prefWidth="63.0" text="Select file:" />
            <TextField fx:id="fileSelectField"
                       layoutX="99.0" layoutY="214.0" />
            <Button layoutX="256.0" layoutY="214.0"
                    mnemonicParsing="false" onAction="#onBrowse" text="Browse" />
            <ProgressBar fx:id="cseProgressBar"
                         layoutX="99.0" layoutY="263.0"
                         prefWidth="200.0" progress="0.0" />
            <Button layoutX="99.0" layoutY="303.0"
                    mnemonicParsing="false" onAction="#onEncrypt"
                    prefHeight="36.0" prefWidth="63.0" text="Encrypt" />
            <Button fx:id="uploadBtn" layoutX="173.0" layoutY="303.0"
                    managed="false" mnemonicParsing="false" onAction="#onUpload"
                    prefHeight="36.0" prefWidth="63.0" text="Upload" visible="false" />
            <Button fx:id="cancelUploadBtn" layoutX="248.0" layoutY="303.0"
                    managed="false" mnemonicParsing="false" onAction="#onCancelUpload"
                    prefHeight="36.0" prefWidth="52.0" text="Cancel" visible="false" />
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
