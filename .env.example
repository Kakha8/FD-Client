# Copy this file to .env. The .env file is intentionally not committed.
# The desktop client uses the shared AWS preview by default.
FDCLIENT_API_BASE_URL=http://file-drive-preview-1837123084.eu-central-1.elb.amazonaws.com

# Local development override:
# FDCLIENT_API_BASE_URL=https://localhost:8443

# WebAuthn is disabled in the HTTP-only AWS preview. For local development,
# this exact origin must match the backend's app.webauthn.origins value.
# FDCLIENT_WEBAUTHN_ORIGIN=http://localhost:5173

# Example for another device on the same LAN:
# FDCLIENT_API_BASE_URL=https://192.168.100.5:8443
